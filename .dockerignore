# Dependencies & caches
node_modules
**/node_modules
.pnpm-store
.turbo
**/.turbo

# Git / IDE
.git
.gitignore
.cursor
.vscode
.idea
**/.DS_Store

# Env & secrets (keep examples)
.env
.env.*
!.env.example
!**/.env.example
apps/api/.env
apps/web/.env
apps/mobile/.env

# Build outputs
dist
**/dist
build
**/build
coverage
**/coverage
.next
**/.next
out
storybook-static
**/*.tsbuildinfo

# Tests / local tooling (e2e is dockerignored — Next must not typecheck playwright.config)
apps/web/e2e
apps/web/playwright.config.ts
apps/web/playwright-report
apps/web/test-results
apps/api/coverage
apps/api/test
**/*.log

# Mobile is not part of api/web images; keep package.json so the pnpm workspace is valid
apps/mobile/**
!apps/mobile/package.json

# Docs & misc (not needed to build images)
docs
.github
agent-transcripts
infrastructure/k8s
infrastructure/terraform
