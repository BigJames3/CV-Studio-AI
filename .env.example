# Root env template — copy values into apps/*/.env
# Never commit real secrets.

NODE_ENV=development

# Database (matches root docker-compose.yml + infrastructure/docker)
DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
DIRECT_DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (must be ≥32 chars, distinct, never the documented defaults)
JWT_ACCESS_SECRET=dev-only-change-me-access-min-32-chars!!
JWT_REFRESH_SECRET=dev-only-change-me-refresh-min-32-chars!
JWT_SECRET=dev-only-change-me-access-min-32-chars!!
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# API / Web
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (Sprint 1+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# CinetPay (Mobile Money / West Africa)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_USD_XOF_RATE=656
CINETPAY_FAIL_CLOSED=true
API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# API logging (copy into apps/api/.env)
# LOG_LEVEL=debug
# LOG_FORMAT=json
# LOG_PAYMENTS=true

# AES-256-GCM for 2FA secrets and OAuth provider tokens (≥32 chars, required in production)
ENCRYPTION_KEY=dev-only-change-me-encrypt-min-32-chars!!

# LinkedIn OAuth (OpenID)
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# AWS (S3 / later)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# AI vendors (optional local)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PostHog (same phc_ project key on web + api)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_MARKETING_SPEND_MONTHLY=0

# Sentry (separate DSNs: Next.js project vs NestJS/Node project)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# IR_WEBHOOK_URL=
AI_HISTORY_TTL_DAYS=7
