# Root env template — copy values into apps/*/.env
# Never commit real secrets.

NODE_ENV=development

# Host-side `pnpm dev` uses localhost (Compose publishes ports).
# In containers, docker-compose.yml overrides these with @postgres / @redis / @mailpit.
DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
DIRECT_DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (must be ≥32 chars, distinct, never the documented defaults)
JWT_ACCESS_SECRET=dev-only-change-me-access-min-32-chars!!
JWT_REFRESH_SECRET=dev-only-change-me-refresh-min-32-chars!
JWT_SECRET=dev-only-change-me-access-min-32-chars!!
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# API / Web
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (Sprint 1+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=

# Paystack (test key sk_test_ outside production). Placeholders (xxx) = unconfigured.
# The webhook is signed with this same secret key (HMAC-SHA512, x-paystack-signature).
PAYSTACK_SECRET_KEY=sk_test_xxx
# Fail-closed billing (also implied unless PAYMENT_FAIL_CLOSED=0). Set 1 in staging.
PAYMENT_FAIL_CLOSED=1
# Charge currency (Paystack Côte d'Ivoire: XOF).
PAYMENT_CURRENCY=XOF
# Production go-live only (accepts sk_live_) — never set on staging:
# PAYSTACK_ALLOW_LIVE=1
# Optional price overrides, in major units (F CFA). Default: EUR catalog × 655.957, rounded up to 100 F.
# PAYSTACK_PRICE_PRO_MONTHLY=6600
# PAYSTACK_PRICE_PRO_YEARLY=65000
# PAYSTACK_PRICE_BUSINESS_MONTHLY=19700
# PAYSTACK_PRICE_BUSINESS_YEARLY=196200
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# API logging (copy into apps/api/.env)
# LOG_LEVEL=debug
# LOG_FORMAT=json

# AES-256-GCM for 2FA secrets and OAuth provider tokens (≥32 chars, required in production)
ENCRYPTION_KEY=dev-only-change-me-encrypt-min-32-chars!!

# LinkedIn OAuth (OpenID)
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# AWS (S3 / later)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# AI vendors (optional local)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PostHog (same phc_ project key on web + api)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_MARKETING_SPEND_MONTHLY=0

# Sentry (separate DSNs: Next.js project vs NestJS/Node project)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# IR_WEBHOOK_URL=
AI_HISTORY_TTL_DAYS=7
