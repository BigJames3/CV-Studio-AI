# Root env template — copy values into apps/*/.env
# Never commit real secrets.

NODE_ENV=development

# Database (matches root docker-compose.yml + infrastructure/docker)
DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
DIRECT_DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
JWT_SECRET=dev-only-change-me-access
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# API / Web
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (Sprint 1+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email (SMTP via MailService — auth verify / reset)
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=

# Resend (lifecycle emails — welcome / upgrade / expiration / reactivation)
RESEND_API_KEY=
RESEND_FROM=CV Studio AI <noreply@cvstudio.ai>
RESEND_REPLY_TO=support@cvstudio.ai
EMAIL_DRY_RUN=

# Email (legacy placeholder)
SENDGRID_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_BUSINESS_ANNUAL=

# Comma-separated admin emails for /admin and analytics metrics
ADMIN_EMAILS=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# CAC estimate for admin analytics (monthly marketing spend)
ANALYTICS_MARKETING_SPEND_MONTHLY=0


# AES-GCM for 2FA secrets (falls back to JWT_ACCESS_SECRET)
ENCRYPTION_KEY=

# LinkedIn OAuth (OpenID)
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# AWS (S3 / later)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# AI vendors (optional local)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
