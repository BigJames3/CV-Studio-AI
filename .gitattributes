# Store text with LF in the repo and check it out as LF everywhere,
# matching .editorconfig and .prettierrc.json (endOfLine: lf).
# Overrides core.autocrlf=true on Windows machines.
* text=auto eol=lf

# Never convert binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
