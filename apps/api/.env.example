DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
DIRECT_DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
REDIS_URL=redis://localhost:6379
PORT=3001
JWT_ACCESS_SECRET=dev-only-change-me-access-min-32-chars!!
JWT_REFRESH_SECRET=dev-only-change-me-refresh-min-32-chars!
CORS_ORIGINS=http://localhost:3000,http://localhost:3003
APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=CV Studio AI <noreply@cvstudio.local>
# Resend (marketing / lifecycle emails). Leave empty to log-only in dev.
RESEND_API_KEY=
RESEND_FROM=CV Studio AI <noreply@cvstudio.ai>
RESEND_REPLY_TO=support@cvstudio.ai
# Set EMAIL_DRY_RUN=1 to skip Resend sends and log only (even with a key)
EMAIL_DRY_RUN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Fail-closed billing in prod (also implied by NODE_ENV=production)
STRIPE_FAIL_CLOSED=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Alias accepted by API (same as YEARLY)
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
ADMIN_EMAILS=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# PostHog (server-side events). Leave empty for dry-run logs in dev.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional monthly marketing spend used for CAC (admin analytics).
ANALYTICS_MARKETING_SPEND_MONTHLY=0

# AI gateway (optimize-resume). Default: heuristic if no key; openai when OPENAI_API_KEY is set.
AI_PROVIDER=
OPENAI_API_KEY=
AI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# PDF worker / Chromium (Dockerfile.worker sets PUPPETEER_EXECUTABLE_PATH)
PUPPETEER_EXECUTABLE_PATH=
CHROMIUM_PATH=
