DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
DIRECT_DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
# Prisma connections per process (default 5) unless DATABASE_URL sets connection_limit.
# Replicas × pool size must stay under PostgreSQL max_connections.
# DATABASE_POOL_SIZE=5
REDIS_URL=redis://localhost:6379
PORT=3001
JWT_ACCESS_SECRET=dev-only-change-me-access-min-32-chars!!
JWT_REFRESH_SECRET=dev-only-change-me-refresh-min-32-chars!
ENCRYPTION_KEY=dev-only-change-me-encrypt-min-32-chars!!
# Behind nginx/load balancer set TRUST_PROXY=1 (never enable without a real proxy)
# TRUST_PROXY=1
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# JWT_IDLE_TIMEOUT=60m
# ACCOUNT_LOCKOUT_ATTEMPTS=5
# ACCOUNT_LOCKOUT_MINUTES=15
# ENABLE_SWAGGER=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3003
APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=CV Studio AI <noreply@cvstudio.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Connect endpoint ("events on connected accounts", e.g. account.updated) has its own secret.
# Not needed locally: `stripe listen` signs every event with STRIPE_WEBHOOK_SECRET.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Fail-closed billing (also implied unless STRIPE_FAIL_CLOSED=0). Set 1 in staging.
STRIPE_FAIL_CLOSED=1
# Production go-live only — never set on staging:
# STRIPE_ALLOW_LIVE=1
# Catalog Price IDs — required for Stripe checkout (placeholders fail closed).
# Not required to boot locally; checkout returns STRIPE_PRICE_NOT_CONFIGURED until set.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
API_URL=http://localhost:3001
# Logging: LOG_LEVEL=log|debug (default: log in production, debug elsewhere)
# LOG_FORMAT=json writes one JSON object per line (set in k8s); unset = readable text
# LOG_LEVEL=debug
# LOG_FORMAT=json
# E2E only — disables login/register Redis rate limits (never set in production)
# AUTH_RATE_LIMIT_DISABLED=true
# E2E only — disables the global per-route throttler (ignored when NODE_ENV=production)
# THROTTLE_DISABLED=true
# Jest e2e: copy apps/api/.env.test (or `pnpm docker:test` + DATABASE_URL there).
# 2FA setup endpoints are off in test (NODE_ENV=test) unless ENABLE_TWO_FACTOR=true
# ENABLE_TWO_FACTOR=true
SENTRY_DSN=
# Incident paging (P1 security_alert JSON POST)
# IR_WEBHOOK_URL=
# IR_ONCALL_EMAIL=oncall@cvstudio.ai
# AI history retention (days)
AI_HISTORY_TTL_DAYS=7
# SENTRY_ENVIRONMENT=staging
# SENTRY_DEV=true
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Estimated monthly marketing budget in USD. 0 or unset → CAC shows as null.
ANALYTICS_MARKETING_SPEND_MONTHLY=0
# Send development errors to Sentry (default: dropped)
# SENTRY_DEV=true
# AI gateway (optimize-resume). Default: heuristic if no key; openai when OPENAI_API_KEY is set.
AI_PROVIDER=
OPENAI_API_KEY=
AI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# PDF worker / Chromium (the Docker image sets PUPPETEER_EXECUTABLE_PATH)
# queue: render in PDF workers (WORKER_KIND=pdf node dist/worker.js); unset: inline in the API
PDF_RENDER_MODE=
PDF_WORKER_CONCURRENCY=2
PUPPETEER_EXECUTABLE_PATH=
CHROMIUM_PATH=
