DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
DIRECT_DATABASE_URL=postgresql://cvstudio:cvstudio@localhost:5432/cvstudio?schema=public
REDIS_URL=redis://localhost:6379
PORT=3001
JWT_ACCESS_SECRET=dev-only-change-me-access-min-32-chars!!
JWT_REFRESH_SECRET=dev-only-change-me-refresh-min-32-chars!
ENCRYPTION_KEY=dev-only-change-me-encrypt-min-32-chars!!
# Behind nginx/load balancer set TRUST_PROXY=1 (never enable without a real proxy)
# TRUST_PROXY=1
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# JWT_IDLE_TIMEOUT=60m
# ACCOUNT_LOCKOUT_ATTEMPTS=5
# ACCOUNT_LOCKOUT_MINUTES=15
# ENABLE_SWAGGER=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3003
APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
# Production relay: SMTP_USER / SMTP_PASS, and SMTP_SECURE=true for implicit TLS (port 465).
# Certificates are verified when NODE_ENV=production.
MAIL_FROM=CV Studio AI <noreply@cvstudio.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Paystack (test key sk_test_ outside production). Placeholders (xxx) = unconfigured.
# The webhook is signed with this same secret key (HMAC-SHA512, x-paystack-signature).
PAYSTACK_SECRET_KEY=sk_test_xxx
# Fail-closed billing (also implied unless PAYMENT_FAIL_CLOSED=0). Set 1 in staging.
PAYMENT_FAIL_CLOSED=1
# Charge currency (Paystack Côte d'Ivoire: XOF).
PAYMENT_CURRENCY=XOF
# Production go-live only (accepts sk_live_) — never set on staging:
# PAYSTACK_ALLOW_LIVE=1
# Optional price overrides, in major units (F CFA). Default: EUR catalog × 655.957, rounded up to 100 F.
# PAYSTACK_PRICE_PRO_MONTHLY=6600
# PAYSTACK_PRICE_PRO_YEARLY=65000
# PAYSTACK_PRICE_BUSINESS_MONTHLY=19700
# PAYSTACK_PRICE_BUSINESS_YEARLY=196200
API_URL=http://localhost:3001
# Logging
# LOG_LEVEL=debug
# LOG_FORMAT=json
# E2E only — disables login/register Redis rate limits (never set in production)
# AUTH_RATE_LIMIT_DISABLED=true
# E2E only — disables the global per-route throttler (ignored when NODE_ENV=production)
# THROTTLE_DISABLED=true
# Jest e2e: copy apps/api/.env.test (or `pnpm docker:test` + DATABASE_URL there).
# 2FA setup endpoints are off in test (NODE_ENV=test) unless ENABLE_TWO_FACTOR=true
# ENABLE_TWO_FACTOR=true
SENTRY_DSN=
# Incident paging (P1 security_alert JSON POST)
# IR_WEBHOOK_URL=
# IR_ONCALL_EMAIL=oncall@cvstudio.ai
# AI history retention (days)
AI_HISTORY_TTL_DAYS=7
# SENTRY_ENVIRONMENT=staging
# SENTRY_DEV=true
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Server events (sign-up, login) reach PostHog only with POSTHOG_SERVER_CAPTURE=true: they
# ignore the visitor's cookie choice. They are always kept in analytics_events.
# POSTHOG_SERVER_CAPTURE=false
# Estimated monthly marketing budget in USD. 0 or unset → CAC shows as null.
ANALYTICS_MARKETING_SPEND_MONTHLY=0
# Send development errors to Sentry (default: dropped)
# SENTRY_DEV=true
# AI gateway (optimize-resume). Default: heuristic if no key; openai when OPENAI_API_KEY is set.
AI_PROVIDER=
OPENAI_API_KEY=
AI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# PDF worker / Chromium (Dockerfile.worker sets PUPPETEER_EXECUTABLE_PATH)
PUPPETEER_EXECUTABLE_PATH=
CHROMIUM_PATH=

# Marketplace moderators: comma-separated user ids (UUID). Empty = nobody can publish listings.
MARKETPLACE_MODERATOR_IDS=
