# Copy to apps/api/.env.local (gitignored). Loaded before .env.
# Paste Stripe Dashboard TEST keys only (sk_test_ / pk_test_ / whsec_).
# Never use sk_live_. Never commit this file.

STRIPE_FAIL_CLOSED=1
# STRIPE_ALLOW_LIVE=0

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Catalog Price IDs required for checkout (placeholders fail closed; app still boots without them).
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
# Annual aliases (optional; YEARLY is canonical)
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_BUSINESS_ANNUAL=price_...
