# Copy to apps/api/.env.local (gitignored). Loaded before .env.
# Paste the Paystack Dashboard TEST secret key only (sk_test_).
# Never use sk_live_. Never commit this file.

PAYMENT_FAIL_CLOSED=1
PAYMENT_CURRENCY=XOF
# PAYSTACK_ALLOW_LIVE=0

# PAYSTACK_SECRET_KEY=sk_test_...
# Optional price overrides in F CFA (default: EUR catalog converted at 655.957).
# PAYSTACK_PRICE_PRO_MONTHLY=6600
# PAYSTACK_PRICE_PRO_YEARLY=65000
# PAYSTACK_PRICE_BUSINESS_MONTHLY=19700
# PAYSTACK_PRICE_BUSINESS_YEARLY=196200
