{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s",
    "!**/main.ts",
    "!**/scripts/**",
    "!**/*.module.ts",
    "!**/dto/**"
  ],
  "coverageDirectory": "../coverage",
  "coverageThreshold": {
    "**/modules/ai/ai.service.ts": {
      "branches": 80,
      "functions": 100,
      "lines": 95,
      "statements": 95
    },
    "**/modules/ai/ai-quota.service.ts": {
      "branches": 80,
      "functions": 90,
      "lines": 90,
      "statements": 90
    },
    "**/modules/payments/payments.service.ts": {
      "branches": 60,
      "functions": 70,
      "lines": 75,
      "statements": 75
    }
  },
  "testEnvironment": "node"
}
