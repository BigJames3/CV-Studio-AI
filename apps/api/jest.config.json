{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s",
    "!**/main.ts",
    "!**/scripts/**",
    "!**/*.module.ts",
    "!**/dto/**"
  ],
  "coverageDirectory": "../coverage",
  "coverageThreshold": {
    "**/modules/ai/ai.service.ts": {
      "branches": 60,
      "functions": 90,
      "lines": 90,
      "statements": 90
    },
    "**/modules/ai/ai-quota.service.ts": {
      "branches": 85,
      "functions": 90,
      "lines": 90,
      "statements": 90
    },
    "**/modules/payments/payments.service.ts": {
      "branches": 40,
      "functions": 60,
      "lines": 60,
      "statements": 60
    },
    "**/modules/marketplace/marketplace.service.ts": {
      "branches": 55,
      "functions": 55,
      "lines": 65,
      "statements": 65
    }
  },
  "testEnvironment": "node"
}
