// CV Studio AI — Prisma Schema v2.0 (Database Architect)
// Canonical source for PostgreSQL 16+
// Companion SQL: docs/sql/*.sql (partitions, RLS, extra indexes)
// Doc: docs/DATABASE-CV-STUDIO-AI.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL") // bypass PgBouncer for migrations
  extensions = [citext, pgcrypto]
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum SubscriptionTier {
  free
  pro
  business
}

enum OAuthProvider {
  google
  linkedin
  apple
}

enum TemplateCategory {
  modern
  creative
  executive
  startup
  ats_optimized
}

enum SkillProficiency {
  beginner
  intermediate
  advanced
  expert
}

enum LanguageProficiency {
  elementary
  limited_working
  professional
  full_professional
  native
}

enum SubscriptionStatus {
  active
  canceled
  suspended
  past_due
  trialing
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
  uncollectible
}

enum AiActionType {
  cv_generation
  resume_optimization
  cover_letter
  interview_prep
  jd_match
  career_advice
}

enum NotificationType {
  email
  in_app
  sms
}

enum CollabRole {
  owner
  editor
  commenter
  viewer
}

enum TeamRole {
  owner
  admin
  editor
  viewer
}

enum SellerStatus {
  pending_kyc
  active
  rejected
  suspended
}

enum SellerTier {
  new
  trusted
  partner
}

enum ListingStatus {
  draft
  submitted
  in_review
  changes_requested
  approved
  published
  unpublished
  rejected
  suspended
}

enum ModerationDecision {
  approve
  request_changes
  reject
}

enum DisputeType {
  quality
  access
  billing
  ip
}

enum DisputeStatus {
  open
  seller_responded
  under_review
  resolved_refund
  resolved_partial
  resolved_denied
  closed
}

enum CopyrightClaimStatus {
  received
  listing_suspended
  countered
  resolved_upheld
  resolved_rejected
}

enum LedgerEntryType {
  charge_gross
  stripe_fee
  platform_commission
  seller_earning
  reserve_hold
  reserve_release
  payout
  refund_clawback
}

enum PayoutStatus {
  pending
  in_transit
  paid
  failed
}

// ─────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────

model User {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String           @unique @db.Citext
  passwordHash               String?          @map("password_hash") @db.VarChar(255)
  firstName                  String           @map("first_name") @db.VarChar(120)
  lastName                   String           @map("last_name") @db.VarChar(120)
  avatarUrl                  String?          @map("avatar_url") @db.VarChar(2048)
  phone                      String?          @db.VarChar(64)
  location                   String?          @db.VarChar(255)
  countryCode                String?          @map("country_code") @db.Char(2)
  bio                        String?          @db.Text
  dateOfBirth                DateTime?        @map("date_of_birth") @db.Date
  subscriptionTier           SubscriptionTier @default(free) @map("subscription_tier")
  subscriptionStartDate      DateTime?        @map("subscription_start_date") @db.Timestamptz(6)
  subscriptionEndDate        DateTime?        @map("subscription_end_date") @db.Timestamptz(6)
  isEmailVerified            Boolean          @default(false) @map("is_email_verified")
  is2faEnabled               Boolean          @default(false) @map("is_2fa_enabled")
  twoFactorSecretEncrypted   Bytes?           @map("two_factor_secret_encrypted") // AES-GCM ciphertext
  lastLoginAt                 DateTime?        @map("last_login_at") @db.Timestamptz(6)
  emailVerificationSentAt     DateTime?        @map("email_verification_sent_at") @db.Timestamptz(6)
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                   DateTime?        @map("deleted_at") @db.Timestamptz(6)

  oauthAccounts         UserOauthAccount[]
  authSessions          AuthSession[]
  cvs                   Cv[]
  templatesCreated      Template[]           @relation("TemplateCreator")
  subscription          Subscription?
  aiHistories           AiHistory[]
  analyticsEvents       AnalyticsEvent[]
  marketplaceTemplates  MarketplaceTemplate[]
  templateReviews       TemplateReview[]
  marketplacePurchases  MarketplacePurchase[]
  sellerProfile         SellerProfile?
  disputesOpened        MarketplaceDispute[] @relation("DisputeBuyer")
  copyrightClaims       CopyrightClaim[]
  notifications         Notification[]
  portfolios            Portfolio[]
  auditLogs             AuditLog[]
  teamMembers           TeamMember[]
  collabSessions        CollabSession[]
  collabSnapshots       CollabSnapshot[]     @relation("SnapshotAuthor")

  @@index([subscriptionTier], map: "idx_users_subscription_tier")
  @@index([createdAt], map: "idx_users_created_at")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model AuthSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @unique @map("family_id") @db.Uuid
  refreshJti String    @map("refresh_jti") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt], map: "idx_auth_sessions_user_revoked")
  @@map("auth_sessions")
}

model UserOauthAccount {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  provider              OAuthProvider
  providerId            String        @map("provider_id") @db.VarChar(255)
  accessTokenEncrypted  Bytes         @map("access_token_encrypted")
  refreshTokenEncrypted Bytes?        @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?     @map("token_expires_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerId], map: "uidx_oauth_provider_provider_id")
  @@index([userId], map: "idx_oauth_user_id")
  @@map("user_oauth_accounts")
}

// ─────────────────────────────────────────────
// Teams (Business)
// ─────────────────────────────────────────────

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(editor)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([teamId, userId], map: "uidx_team_members_team_user")
  @@index([userId], map: "idx_team_members_user_id")
  @@map("team_members")
}

// ─────────────────────────────────────────────
// Templates
// ─────────────────────────────────────────────

model Template {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(200)
  description     String           @db.Text
  category        TemplateCategory
  previewImageUrl String           @map("preview_image_url") @db.VarChar(2048)
  isPremium       Boolean          @default(false) @map("is_premium")
  price           Decimal?         @db.Decimal(10, 2)
  designData      Json             @map("design_data")
  isPublished     Boolean          @default(false) @map("is_published")
  downloadCount   Int              @default(0) @map("download_count")
  rating          Decimal          @default(0) @db.Decimal(3, 2)
  createdBy       String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator              User?                @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cvs                  Cv[]
  marketplaceTemplate  MarketplaceTemplate?

  @@index([category], map: "idx_templates_category")
  @@index([isPremium], map: "idx_templates_is_premium")
  @@index([isPublished], map: "idx_templates_is_published")
  @@index([createdBy], map: "idx_templates_created_by")
  @@map("templates")
}

// ─────────────────────────────────────────────
// CVs + sections (3NF) + JSONB document
// ─────────────────────────────────────────────

model Cv {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(200)
  templateId  String?   @map("template_id") @db.Uuid
  content     Json // source of truth éditeur (schemaVersion inside)
  schemaVersion Int     @default(1) @map("schema_version")
  isPublic    Boolean   @default(false) @map("is_public")
  publicUrl   String?   @unique @map("public_url") @db.VarChar(255)
  viewCount   Int       @default(0) @map("view_count")
  isStarred   Boolean   @default(false) @map("is_starred")
  locale      String    @default("fr-FR") @db.VarChar(16)
  paper       String    @default("A4") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  template       Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       CvVersion[]
  experiences    Experience[]
  education      Education[]
  skills         Skill[]
  projects       Project[]
  languages      Language[]
  certificates   Certificate[]
  atsReports     AtsReport[]
  aiHistories    AiHistory[]
  collabSessions CollabSession[]
  collabSnapshots CollabSnapshot[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_cvs_user_updated")
  @@index([templateId], map: "idx_cvs_template_id")
  @@index([createdAt], map: "idx_cvs_created_at")
  @@index([isPublic], map: "idx_cvs_is_public")
  @@index([deletedAt], map: "idx_cvs_deleted_at")
  @@map("cvs")
}

model CvVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId          String   @map("cv_id") @db.Uuid
  versionNumber Int      @map("version_number")
  content       Json
  label         String?  @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([cvId, versionNumber], map: "uidx_cv_versions_cv_version")
  @@index([cvId, versionNumber], map: "idx_cv_versions_cv_version")
  @@map("cv_versions")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId        String    @map("cv_id") @db.Uuid
  companyName String    @map("company_name") @db.VarChar(200)
  jobTitle    String    @map("job_title") @db.VarChar(200)
  location    String?   @db.VarChar(255)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cvId, sortOrder], map: "idx_experiences_cv_order")
  @@map("experiences")
}

model Education {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId         String    @map("cv_id") @db.Uuid
  schoolName   String    @map("school_name") @db.VarChar(200)
  degree       String    @db.VarChar(200)
  fieldOfStudy String    @map("field_of_study") @db.VarChar(200)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isOngoing    Boolean   @default(false) @map("is_ongoing")
  grade        String?   @db.VarChar(64)
  description  String?   @db.Text
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cvId, sortOrder], map: "idx_education_cv_order")
  @@map("education")
}

model Skill {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId              String           @map("cv_id") @db.Uuid
  skillName         String           @map("skill_name") @db.VarChar(120)
  proficiency       SkillProficiency @default(intermediate)
  endorsementsCount Int              @default(0) @map("endorsements_count")
  sortOrder         Int              @default(0) @map("sort_order")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cvId, sortOrder], map: "idx_skills_cv_order")
  @@map("skills")
}

model Project {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId         String    @map("cv_id") @db.Uuid
  title        String    @db.VarChar(200)
  description  String    @db.Text
  technologies String[]
  url          String?   @db.VarChar(2048)
  imageUrl     String?   @map("image_url") @db.VarChar(2048)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cvId, sortOrder], map: "idx_projects_cv_order")
  @@map("projects")
}

model Language {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId        String              @map("cv_id") @db.Uuid
  language    String              @db.VarChar(120)
  proficiency LanguageProficiency @default(professional)
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cvId, sortOrder], map: "idx_languages_cv_order")
  @@map("languages")
}

model Certificate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId           String    @map("cv_id") @db.Uuid
  name           String    @db.VarChar(200)
  issuer         String    @db.VarChar(200)
  issueDate      DateTime  @map("issue_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date
  url            String?   @db.VarChar(2048)
  credentialId   String?   @map("credential_id") @db.VarChar(200)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cvId, sortOrder], map: "idx_certificates_cv_order")
  @@map("certificates")
}

// ─────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────

model Plan {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @unique @db.VarChar(64)
  description       String   @db.Text
  priceMonthly      Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly       Decimal  @map("price_yearly") @db.Decimal(10, 2)
  cvLimit           Int      @map("cv_limit")
  aiFeatures        Boolean  @default(false) @map("ai_features")
  prioritySupport   Boolean  @default(false) @map("priority_support")
  customDomain      Boolean  @default(false) @map("custom_domain")
  marketplaceAccess Boolean  @default(false) @map("marketplace_access")
  apiAccess         Boolean  @default(false) @map("api_access")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@index([isActive], map: "idx_plans_is_active")
  @@map("plans")
}

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz(6)
  stripeSubscriptionId   String?            @map("stripe_subscription_id") @db.VarChar(255)
  provider               String?            @db.VarChar(32) // 'stripe' | 'cinetpay'
  cinetpayTransactionId  String?            @unique @map("cinetpay_transaction_id") @db.VarChar(255)
  lastPaymentError       String?            @map("last_payment_error") @db.VarChar(512)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments Payment[]
  invoices Invoice[]

  @@index([status], map: "idx_subscriptions_status")
  @@index([currentPeriodEnd], map: "idx_subscriptions_period_end")
  @@index([stripeSubscriptionId], map: "idx_subscriptions_stripe")
  @@map("subscriptions")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId        String        @map("subscription_id") @db.Uuid
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @db.VarChar(8)
  status                PaymentStatus @default(pending)
  paymentMethod         String        @map("payment_method") @db.VarChar(64)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id") @db.VarChar(255)
  transactionId         String?       @unique @map("transaction_id") @db.VarChar(255)
  failedReason          String?       @map("failed_reason") @db.Text
  retryCount            Int           @default(0) @map("retry_count")
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([subscriptionId], map: "idx_payments_subscription_id")
  @@index([status], map: "idx_payments_status")
  @@index([createdAt], map: "idx_payments_created_at")
  @@map("payments")
}

/// Durable Stripe webhook idempotency + DLQ (fail-closed billing).
enum StripeWebhookStatus {
  processing
  processed
  dlq
}

model StripeWebhookEvent {
  id          String              @id @db.VarChar(255) // Stripe event.id
  type        String              @db.VarChar(128)
  status      StripeWebhookStatus @default(processing)
  attempts    Int                 @default(0)
  lastError   String?             @map("last_error") @db.Text
  payload     Json?
  processedAt DateTime?           @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status], map: "idx_stripe_webhook_events_status")
  @@index([createdAt], map: "idx_stripe_webhook_events_created_at")
  @@map("stripe_webhook_events")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(64)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @db.VarChar(8)
  status         InvoiceStatus @default(draft)
  pdfUrl         String?       @map("pdf_url") @db.VarChar(2048)
  dueDate        DateTime      @map("due_date") @db.Date
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([subscriptionId], map: "idx_invoices_subscription_id")
  @@index([status], map: "idx_invoices_status")
  @@index([createdAt], map: "idx_invoices_created_at")
  @@map("invoices")
}

// ─────────────────────────────────────────────
// ATS & AI
// ─────────────────────────────────────────────

model AtsReport {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId                 String   @map("cv_id") @db.Uuid
  jobDescription       String?  @map("job_description") @db.Text
  atsScore             Decimal  @map("ats_score") @db.Decimal(5, 2)
  missingKeywords      String[] @map("missing_keywords")
  recommendations      Json
  generatedOptimizedCv Json?    @map("generated_optimized_cv")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([cvId, createdAt(sort: Desc)], map: "idx_ats_reports_cv_created")
  @@map("ats_reports")
}

model AiHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  cvId       String?      @map("cv_id") @db.Uuid
  actionType AiActionType @map("action_type")
  prompt     String       @db.Text
  result     Json
  tokensUsed Int          @map("tokens_used")
  costUsd    Decimal?     @map("cost_usd") @db.Decimal(10, 6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cv   Cv?  @relation(fields: [cvId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_ai_histories_user_created")
  @@index([actionType], map: "idx_ai_histories_action_type")
  @@index([cvId], map: "idx_ai_histories_cv_id")
  @@map("ai_histories")
}

// ─────────────────────────────────────────────
// Analytics (partitioned in SQL — see docs/sql)
// ─────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(128)
  eventData Json?    @map("event_data")
  sessionId String?  @map("session_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_analytics_user_created")
  @@index([eventType, createdAt(sort: Desc)], map: "idx_analytics_type_created")
  @@map("analytics_events")
}

// ─────────────────────────────────────────────
// Marketplace
// ─────────────────────────────────────────────

model SellerProfile {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  displayName        String       @map("display_name") @db.VarChar(80)
  slug               String       @unique @db.VarChar(80)
  bio                String?      @db.VarChar(500)
  avatarUrl          String?      @map("avatar_url") @db.VarChar(2048)
  country            String       @db.VarChar(2)
  portfolioUrl       String?      @map("portfolio_url") @db.VarChar(2048)
  status             SellerStatus @default(pending_kyc)
  tier               SellerTier   @default(new)
  stripeAccountId    String?      @unique @map("stripe_account_id") @db.VarChar(255)
  payoutsEnabled     Boolean      @default(false) @map("payouts_enabled")
  tosAcceptedAt      DateTime?    @map("tos_accepted_at") @db.Timestamptz(6)
  ipStrikes          Int          @default(0) @map("ip_strikes")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts  SellerPayout[]
  listings MarketplaceTemplate[]

  @@index([status], map: "idx_seller_profiles_status")
  @@index([tier], map: "idx_seller_profiles_tier")
  @@map("seller_profiles")
}

model MarketplaceTemplate {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId      String        @unique @map("template_id") @db.Uuid
  sellerId        String        @map("seller_id") @db.Uuid
  sellerProfileId String?       @map("seller_profile_id") @db.Uuid
  title           String        @db.VarChar(120)
  slug            String        @unique @db.VarChar(140)
  description     String?       @db.Text
  priceCents      Int           @map("price_cents")
  currency        String        @default("USD") @db.VarChar(3)
  status          ListingStatus @default(draft)
  isPublished     Boolean       @default(false) @map("is_published")
  downloadCount   Int           @default(0) @map("download_count")
  impressionCount Int           @default(0) @map("impression_count")
  rating          Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount     Int           @default(0) @map("review_count")
  tags            String[]      @default([])
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  template      Template              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  seller        User                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile?        @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  reviews       TemplateReview[]
  purchases     MarketplacePurchase[]
  moderations   ListingModeration[]
  disputes      MarketplaceDispute[]
  copyrightClaims CopyrightClaim[]

  @@index([sellerId], map: "idx_marketplace_seller_id")
  @@index([isPublished], map: "idx_marketplace_is_published")
  @@index([status], map: "idx_marketplace_status")
  @@index([priceCents], map: "idx_marketplace_price")
  @@map("marketplace_templates")
}

model ListingModeration {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplaceTemplateId String              @map("marketplace_template_id") @db.Uuid
  decision              ModerationDecision?
  reasonCode            String?             @map("reason_code") @db.VarChar(64)
  notes                 String?             @db.Text
  reviewerId            String?             @map("reviewer_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt             DateTime?           @map("decided_at") @db.Timestamptz(6)

  marketplaceTemplate MarketplaceTemplate @relation(fields: [marketplaceTemplateId], references: [id], onDelete: Cascade)

  @@index([marketplaceTemplateId, createdAt(sort: Desc)], map: "idx_listing_moderation_listing")
  @@map("listing_moderations")
}

model MarketplacePurchase {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId             String    @map("listing_id") @db.Uuid
  buyerId               String    @map("buyer_id") @db.Uuid
  amountCents           Int       @map("amount_cents")
  currency              String    @default("USD") @db.VarChar(3)
  stripePaymentIntentId String?   @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeFeeCents        Int       @default(0) @map("stripe_fee_cents")
  platformFeeCents      Int       @default(0) @map("platform_fee_cents")
  sellerEarningCents    Int       @default(0) @map("seller_earning_cents")
  refundedAt            DateTime? @map("refunded_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  listing MarketplaceTemplate @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer   User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  ledger  MarketplaceLedgerEntry[]
  dispute MarketplaceDispute?

  @@unique([listingId, buyerId], map: "uidx_marketplace_purchase_once")
  @@index([buyerId, createdAt(sort: Desc)], map: "idx_mp_purchase_buyer")
  @@index([listingId], map: "idx_mp_purchase_listing")
  @@map("marketplace_purchases")
}

model MarketplaceLedgerEntry {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId String?         @map("purchase_id") @db.Uuid
  payoutId   String?         @map("payout_id") @db.Uuid
  sellerId   String?         @map("seller_id") @db.Uuid
  entryType  LedgerEntryType @map("entry_type")
  amountCents Int            @map("amount_cents")
  currency   String          @default("USD") @db.VarChar(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  purchase MarketplacePurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  payout   SellerPayout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([purchaseId, entryType], map: "uidx_ledger_purchase_type")
  @@index([sellerId, createdAt], map: "idx_ledger_seller")
  @@map("marketplace_ledger_entries")
}

model SellerPayout {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId       String       @map("seller_profile_id") @db.Uuid
  amountCents           Int          @map("amount_cents")
  currency              String       @default("USD") @db.VarChar(3)
  status                PayoutStatus @default(pending)
  stripeTransferId      String?      @unique @map("stripe_transfer_id") @db.VarChar(255)
  periodStart           DateTime     @map("period_start") @db.Timestamptz(6)
  periodEnd             DateTime     @map("period_end") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt                DateTime?    @map("paid_at") @db.Timestamptz(6)

  sellerProfile SellerProfile            @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  ledger        MarketplaceLedgerEntry[]

  @@index([sellerProfileId, createdAt(sort: Desc)], map: "idx_seller_payouts")
  @@map("seller_payouts")
}

model TemplateReview {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplaceTemplateId String   @map("marketplace_template_id") @db.Uuid
  reviewerId            String   @map("reviewer_id") @db.Uuid
  rating                Int
  comment               String?  @db.Text
  helpfulCount          Int      @default(0) @map("helpful_count")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  marketplaceTemplate MarketplaceTemplate @relation(fields: [marketplaceTemplateId], references: [id], onDelete: Cascade)
  reviewer            User                @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([marketplaceTemplateId, reviewerId], map: "uidx_template_reviews_once")
  @@index([marketplaceTemplateId], map: "idx_template_reviews_mt")
  @@index([reviewerId], map: "idx_template_reviews_reviewer")
  @@map("template_reviews")
}

model MarketplaceDispute {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId String        @unique @map("purchase_id") @db.Uuid
  listingId  String        @map("listing_id") @db.Uuid
  buyerId    String        @map("buyer_id") @db.Uuid
  type       DisputeType
  status     DisputeStatus @default(open)
  reason     String        @db.Text
  sellerResponse String?   @map("seller_response") @db.Text
  resolution String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz(6)

  purchase MarketplacePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  listing  MarketplaceTemplate @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User                @relation("DisputeBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "idx_disputes_status")
  @@map("marketplace_disputes")
}

model CopyrightClaim {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId  String               @map("listing_id") @db.Uuid
  claimantId String?              @map("claimant_id") @db.Uuid
  claimantEmail String            @map("claimant_email") @db.VarChar(320)
  evidenceUrl String?             @map("evidence_url") @db.VarChar(2048)
  description String              @db.Text
  status     CopyrightClaimStatus @default(received)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?            @map("resolved_at") @db.Timestamptz(6)

  listing  MarketplaceTemplate @relation(fields: [listingId], references: [id], onDelete: Cascade)
  claimant User?               @relation(fields: [claimantId], references: [id], onDelete: SetNull)

  @@index([status], map: "idx_copyright_claims_status")
  @@map("copyright_claims")
}

// ─────────────────────────────────────────────
// Notifications & Portfolios
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  actionUrl String?          @map("action_url") @db.VarChar(2048)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notifications_user_read")
  @@map("notifications")
}

model Portfolio {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  items       Json
  publicUrl   String?  @unique @map("public_url") @db.VarChar(255)
  isPublished Boolean  @default(false) @map("is_published")
  noindex     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "idx_portfolios_user_id")
  @@map("portfolios")
}

// ─────────────────────────────────────────────
// Audit (partitioned in SQL)
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(32)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_user_created")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([createdAt(sort: Desc)], map: "idx_audit_created_at")
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Collaboration
// ─────────────────────────────────────────────

model CollabSession {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId      String     @map("cv_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      CollabRole @default(editor)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  cv   Cv   @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([cvId, userId], map: "uidx_collab_cv_user")
  @@index([userId], map: "idx_collab_user_id")
  @@map("collab_sessions")
}

model CollabSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cvId        String   @map("cv_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  state       Bytes // Yjs / CRDT binary
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cv        Cv    @relation(fields: [cvId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User? @relation("SnapshotAuthor", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([cvId, createdAt(sort: Desc)], map: "idx_collab_snapshots_cv")
  @@map("collab_snapshots")
}
