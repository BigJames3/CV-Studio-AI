NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# PostHog (project API key, phc_…). Same key as apps/api POSTHOG_API_KEY.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Force opt-out even in development:
# NEXT_PUBLIC_POSTHOG_OPT_OUT=true

# Sentry frontend DSN (Next.js project). Dev events are dropped unless:
# NEXT_PUBLIC_SENTRY_DEV=true
NEXT_PUBLIC_SENTRY_DSN=
# Playwright (apps/web)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1
# E2E_API_URL=http://localhost:3001/api/v1
# E2E_STRIPE=1
# E2E_REAL_PDF=1
# E2E_PASSWORD=TestPassword123!
# Copy apps/web/.env.test for Playwright defaults.
