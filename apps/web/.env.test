# Playwright / Next test env (no secrets). Loaded by e2e/global-setup.ts.
# NEXT_PUBLIC_API_URL must include /api/v1 — the web client does not prefix it.

API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3001/api/v1

# Do not set CI=false — the string "false" is truthy and blocks reuseExistingServer.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=false
# PLAYWRIGHT_SKIP_WEBSERVER=1
# E2E_STRIPE=1
