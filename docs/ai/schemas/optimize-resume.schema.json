{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OptimizeResumeResult",
  "type": "object",
  "required": ["ok", "variants"],
  "properties": {
    "ok": { "type": "boolean" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["text", "rationale"],
        "properties": {
          "text": { "type": "string" },
          "rationale": { "type": "string" },
          "atsNotes": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "refusals": { "type": "array", "items": { "type": "string" } }
  }
}
