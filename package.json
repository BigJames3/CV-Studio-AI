{
  "name": "cv-studio-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CV Studio AI — AI-powered CV builder SaaS (Turborepo monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@cvstudio/api --filter=@cvstudio/web",
    "dev:all": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@cvstudio/api",
    "dev:web": "turbo run dev --filter=@cvstudio/web",
    "dev:mobile": "turbo run start --filter=@cvstudio/mobile",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@cvstudio/api",
    "build:web": "turbo run build --filter=@cvstudio/web",
    "build:ui": "turbo run build --filter=@cvstudio/ui",
    "start": "turbo run start --filter=@cvstudio/api --filter=@cvstudio/web",
    "start:api": "turbo run start --filter=@cvstudio/api",
    "start:web": "turbo run start --filter=@cvstudio/web",
    "lint": "turbo run lint",
    "lint:fix": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "type-check": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test -- --coverage",
    "test:e2e": "pnpm --filter @cvstudio/web test:e2e",
    "test:e2e:headed": "pnpm --filter @cvstudio/web test:e2e:headed",
    "test:e2e:api": "pnpm --filter @cvstudio/api test:e2e",
    "docker:test": "docker compose -f docker-compose.test.yml up -d --wait",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "db:generate": "pnpm --filter @cvstudio/api exec prisma generate",
    "db:migrate": "pnpm --filter @cvstudio/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @cvstudio/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @cvstudio/api exec prisma db seed",
    "db:studio": "pnpm --filter @cvstudio/api exec prisma studio",
    "db:reset": "pnpm --filter @cvstudio/api exec prisma migrate reset",
    "docker:up": "docker compose up -d postgres redis mailpit",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:app": "docker compose up -d --build",
    "compose:up": "pnpm docker:up",
    "compose:down": "pnpm docker:down",
    "compose:logs": "pnpm docker:logs",
    "clean": "turbo run clean && rimraf node_modules apps/*/node_modules packages/*/node_modules .turbo",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
