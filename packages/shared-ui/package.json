{
  "name": "@cvstudio/shared-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Compatibility alias — re-exports @cvstudio/ui (Design System)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "echo \"@cvstudio/shared-ui re-exports @cvstudio/ui\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@cvstudio/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
