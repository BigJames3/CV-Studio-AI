{
  "name": "@cvstudio/shared-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utilities for CV Studio AI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --import tsx --test src/**/*.test.ts || echo \"no tests yet\"",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@cvstudio/shared-types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
