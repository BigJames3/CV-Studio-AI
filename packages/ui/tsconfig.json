{
  "extends": "../../apps/web/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Same pinning as apps/web: React 19 types, not the hoisted @types/react 18 of apps/mobile.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true
  },
  "include": ["src", ".storybook"],
  "exclude": ["node_modules", "src/**/__tests__/**", "src/**/*.test.tsx", "src/**/*.test.ts"]
}
